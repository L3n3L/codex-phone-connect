<Window x:Class="CodexPhoneConnect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Phone Connect"
        Width="640"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        SizeChanged="Window_SizeChanged"
        WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource PageBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Effect="{DynamicResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <TextBlock Text="Codex Phone Connect"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="−"
                                Style="{StaticResource WindowControlButtonStyle}"
                                Click="MinimizeButton_Click" />
                        <Button Content="×"
                                Style="{StaticResource WindowControlButtonStyle}"
                                FontSize="19"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="MainScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,20">
                <TextBlock Text="设置点击位置"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />

                <Border Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="10"
                        Height="58"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="控制目标"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Margin="6,0,18,0"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <ItemsControl x:Name="AgentButtonsPanel"
                                      Grid.Column="1"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Definition.Id}"
                                            Width="106"
                                            Height="36"
                                            Padding="8,5"
                                            Margin="0,0,6,0"
                                            Background="{Binding Background}"
                                            BorderBrush="{Binding Border}"
                                            Foreground="{Binding Foreground}"
                                            Click="AgentButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}"
                                                   Width="18"
                                                   Height="18"
                                                   Margin="0,0,6,0"
                                                   Stretch="Uniform" />
                                            <TextBlock Text="{Binding Definition.DisplayName}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="16"
                        Height="72"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="输入框" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="InputPointText"
                                       Text="未设置"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="设置"
                                Width="68"
                                Height="34"
                                Click="InputPointButton_Click" />
                    </Grid>
                </Border>

                <Border Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="16"
                        Height="72"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="发送按钮" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="SendPointText"
                                       Text="未设置"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="设置"
                                Width="68"
                                Height="34"
                                Click="SendPointButton_Click" />
                    </Grid>
                </Border>

                <Border Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="16"
                        Height="72"
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="滚动区域" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="ScrollPointText"
                                       Text="未设置"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="设置"
                                Width="68"
                                Height="34"
                                Click="ScrollPointButton_Click" />
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="手机连接"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ServerStateText"
                               Grid.Column="1"
                               Text="服务未启动"
                               Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="16,0,0,0"
                               TextWrapping="Wrap" />
                </Grid>

                <ItemsControl x:Name="ConnectionEntries">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="12"
                                    MinHeight="112"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Connection.Label}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Connection.Url}"
                                                   FontFamily="Cascadia Mono"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding Connection.InterfaceName}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Image Source="{Binding QrCode}"
                                           Grid.Column="1"
                                           Width="96"
                                           Height="96"
                                           Margin="18,0,0,0"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           SnapsToDevicePixels="True"
                                           AutomationProperties.Name="{Binding Connection.Url}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="NoConnectionsPanel"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="16">
                    <Grid>
                        <TextBlock x:Name="ConnectionEmptyText"
                                   Text="正在查找连接地址…"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </Grid>
                </Border>

                <Grid Height="34" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HintText"
                               Text=""
                               Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            x:Name="SaveButton"
                            Content="保存"
                            Width="64"
                            Height="32"
                            Click="SaveButton_Click"
                            IsEnabled="False" />
                </Grid>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
