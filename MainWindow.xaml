<Window x:Class="CodexPhoneConnect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Phone Connect"
        Width="640"
        Height="510"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource PageBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Effect="{DynamicResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <TextBlock Text="Codex Phone Connect"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Content="−"
                                Style="{StaticResource WindowControlButtonStyle}"
                                Click="MinimizeButton_Click" />
                        <Button Content="×"
                                Style="{StaticResource WindowControlButtonStyle}"
                                FontSize="19"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="28,22,28,20">
                <TextBlock Text="设置点击位置"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16" />

                <Border Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="16"
                        Height="72"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="输入框" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="InputPointText"
                                       Text="未设置"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="设置"
                                Width="68"
                                Height="34"
                                Click="InputPointButton_Click" />
                    </Grid>
                </Border>

                <Border Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="16"
                        Height="72"
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="发送按钮" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="SendPointText"
                                       Text="未设置"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="设置"
                                Width="68"
                                Height="34"
                                Click="SendPointButton_Click" />
                    </Grid>
                </Border>

                <TextBlock Text="手机连接"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <Border Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="12"
                        Height="112">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="同一 Wi-Fi 打开" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Name="AddressText"
                                       Text="http://电脑地址:8787"
                                       FontFamily="Cascadia Mono"
                                       FontSize="12"
                                       Margin="0,5,0,0" />
                            <TextBlock x:Name="ServerStateText"
                                       Text="服务未启动"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <Image x:Name="ConnectionQr"
                               Grid.Column="1"
                               Width="84"
                               Height="84"
                               Margin="18,0,0,0"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Grid Height="34" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HintText"
                               Text=""
                               Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            x:Name="SaveButton"
                            Content="保存"
                            Width="64"
                            Height="32"
                            Click="SaveButton_Click"
                            IsEnabled="False" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
