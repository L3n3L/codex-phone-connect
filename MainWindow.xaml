<Window x:Class="CodexPhoneConnect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Phone Connect"
        Width="640"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        SizeChanged="Window_SizeChanged"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BitmapImage x:Key="WeChatDonationQr"
                     UriSource="pack://application:,,,/assets/wechat-donate-qr.png" />
    </Window.Resources>
    <Border Background="{StaticResource PageBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Effect="{DynamicResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <TextBlock Text="Codex Phone Connect"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="−"
                                Style="{StaticResource WindowControlButtonStyle}"
                                Click="MinimizeButton_Click" />
                        <Button Content="×"
                                Style="{StaticResource WindowControlButtonStyle}"
                                FontSize="19"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="MainScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,20">
                <TextBlock Text="设置点击位置"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />

                <Border Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="10"
                        Height="58"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="控制目标"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Margin="6,0,18,0"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <ItemsControl x:Name="AgentButtonsPanel"
                                      Grid.Column="1"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Definition.Id}"
                                            Width="106"
                                            Height="36"
                                            Padding="8,5"
                                            Margin="0,0,6,0"
                                            Background="{Binding Background}"
                                            BorderBrush="{Binding Border}"
                                            Foreground="{Binding Foreground}"
                                            Click="AgentButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}"
                                                   Width="18"
                                                   Height="18"
                                                   Margin="0,0,6,0"
                                                   Stretch="Uniform" />
                                            <TextBlock Text="{Binding Definition.DisplayName}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="16"
                        Height="72"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="输入框" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="InputPointText"
                                       Text="未设置"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="设置"
                                Width="68"
                                Height="34"
                                Click="InputPointButton_Click" />
                    </Grid>
                </Border>

                <Border Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="16"
                        Height="72"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="发送按钮" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="SendPointText"
                                       Text="未设置"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="设置"
                                Width="68"
                                Height="34"
                                Click="SendPointButton_Click" />
                    </Grid>
                </Border>

                <Border Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="16"
                        Height="72"
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="滚动区域" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="ScrollPointText"
                                       Text="未设置"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="设置"
                                Width="68"
                                Height="34"
                                Click="ScrollPointButton_Click" />
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="手机连接"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ServerStateText"
                               Grid.Column="1"
                               Text="服务未启动"
                               Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="16,0,0,0"
                               TextWrapping="Wrap" />
                </Grid>

                <ItemsControl x:Name="ConnectionEntries">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="12"
                                    MinHeight="112"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Connection.Label}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Connection.Url}"
                                                   FontFamily="Cascadia Mono"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding Connection.InterfaceName}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Image Source="{Binding QrCode}"
                                           Grid.Column="1"
                                           Width="96"
                                           Height="96"
                                           Margin="18,0,0,0"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           SnapsToDevicePixels="True"
                                           AutomationProperties.Name="{Binding Connection.Url}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="NoConnectionsPanel"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="16">
                    <Grid>
                        <TextBlock x:Name="ConnectionEmptyText"
                                   Text="正在查找连接地址…"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </Grid>
                </Border>

                <Grid Height="36" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="GitHubButton"
                                Style="{StaticResource FooterIconButtonStyle}"
                                Click="GitHubButton_Click"
                                ToolTip="GitHub 项目"
                                ToolTipService.InitialShowDelay="350"
                                AutomationProperties.Name="打开 Codex Phone Connect GitHub 项目">
                            <!-- Official GitHub mark-github-24 from primer/octicons; used as a project link. -->
                            <Path Width="19"
                                  Height="19"
                                  Stretch="Uniform"
                                  Fill="#24292F"
                                  Data="M10.226 17.284c-2.965-.36-5.054-2.493-5.054-5.256 0-1.123.404-2.336 1.078-3.144-.292-.741-.247-2.314.09-2.965.898-.112 2.111.36 2.83 1.01.853-.269 1.752-.404 2.853-.404 1.1 0 1.999.135 2.807.382.696-.629 1.932-1.1 2.83-.988.315.606.36 2.179.067 2.942.72.854 1.101 2 1.101 3.167 0 2.763-2.089 4.852-5.098 5.234.763.494 1.28 1.572 1.28 2.807v2.336c0 .674.561 1.056 1.235.786 4.066-1.55 7.255-5.615 7.255-10.646C23.5 6.188 18.334 1 11.978 1 5.62 1 .5 6.188.5 12.545c0 4.986 3.167 9.12 7.435 10.669.606.225 1.19-.18 1.19-.786V20.63a2.9 2.9 0 0 1-1.078.224c-1.483 0-2.359-.808-2.987-2.313-.247-.607-.517-.966-1.034-1.033-.27-.023-.359-.135-.359-.27 0-.27.45-.471.898-.471.652 0 1.213.404 1.797 1.235.45.651.921.943 1.483.943.561 0 .92-.202 1.437-.719.382-.381.674-.718.944-.943" />
                        </Button>
                        <Button x:Name="DonateButton"
                                Style="{StaticResource FooterIconButtonStyle}"
                                Margin="4,0,0,0"
                                ToolTipService.InitialShowDelay="350"
                                ToolTipService.ShowDuration="30000"
                                AutomationProperties.Name="打赏作者一杯奶茶">
                            <Path Width="19"
                                  Height="19"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource SecondaryTextBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M4,8 L17,8 L16,18 L5,18 Z M17,10 L19,10 C20.5,10 20.5,15 19,15 L16.5,15 M8,6 C7,5 8,4 8,3 M12,6 C11,5 12,4 12,3" />
                            <Button.ToolTip>
                                <ToolTip Placement="Top"
                                         Padding="0"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <Border Background="White"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="打赏作者一杯奶茶"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8" />
                                            <Border Background="White"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="6">
                                                <Image Source="{StaticResource WeChatDonationQr}"
                                                       Width="224"
                                                       Height="224"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       SnapsToDevicePixels="True"
                                                       AutomationProperties.Name="微信打赏收款二维码" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="HintText"
                               Grid.Column="1"
                               Text=""
                               Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            x:Name="SaveButton"
                            Content="保存"
                            Width="64"
                            Height="32"
                            Click="SaveButton_Click"
                            IsEnabled="False" />
                </Grid>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
